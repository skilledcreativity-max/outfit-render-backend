# Required: a random high-entropy API key shared only with Roblox server Secrets Store.
RENDER_API_KEY=replace-with-a-random-32-byte-secret

# Required: a private S3-compatible bucket.
S3_REGION=us-east-1
S3_BUCKET=outfit-studio-renders
S3_ENDPOINT=
S3_FORCE_PATH_STYLE=false
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# Public HTTPS address of this deployed service. Never derive URLs from Host headers.
PUBLIC_BASE_URL=https://outfit-render-backend.example.com
PORT=3000

# Safe operations budgets.
RENDER_MAX_REQUESTS_PER_MINUTE=30
RENDER_MAX_CONCURRENT_JOBS=2
RENDER_MAX_QUEUE_DEPTH=20
RENDER_SIGNED_URL_TTL_SECONDS=900

# Comma-separated numeric Roblox asset IDs. Requests outside these lists are ignored.
APPROVED_PATTERN_ASSET_IDS=113173180348665,94699424726900,128973577352087,110663893397404,121188698293471,115464468834687,93686312276991,94352248537664,75973219987790,138045279497597,75773536735273
APPROVED_GRAPHIC_ASSET_IDS=
