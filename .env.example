# Required: Generate this value in Render. Store the same value only in Roblox Secrets Store.
RENDER_API_KEY=replace-with-a-random-32-byte-secret

# Required: the public HTTPS Render service URL. Never derive this from Host headers.
PUBLIC_BASE_URL=https://outfit-render-backend.onrender.com
PORT=3000

# Free-beta protection budgets. Links work once and then expire after five minutes.
RENDER_MAX_REQUESTS_PER_MINUTE=12
RENDER_MAX_CONCURRENT_JOBS=1
RENDER_MAX_QUEUE_DEPTH=4
RENDER_DOWNLOAD_TTL_SECONDS=300
RENDER_MAX_RETAINED_DOWNLOADS=10

# Comma-separated numeric Roblox asset IDs. Requests outside these lists are ignored.
APPROVED_PATTERN_ASSET_IDS=113173180348665,94699424726900,128973577352087,110663893397404,121188698293471,115464468834687,93686312276991,94352248537664,75973219987790,138045279497597,75773536735273
APPROVED_GRAPHIC_ASSET_IDS=
