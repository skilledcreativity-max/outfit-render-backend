{
  "name": "outfit-render-backend",
  "version": "2.1.0-beta.1",
  "private": true,
  "description": "Authenticated, bounded, one-time PNG renderer for the Outfit Studio free beta.",
  "main": "server.js",
  "engines": {
    "node": ">=22.0.0 <23"
  },
  "scripts": {
    "start": "node --enable-source-maps server.js",
    "test": "node --test test/*.test.js",
    "audit": "npm audit --omit=dev --audit-level=high"
  },
  "dependencies": {
    "express": "5.2.1",
    "express-rate-limit": "8.6.2",
    "helmet": "8.3.0",
    "jimp": "1.6.1"
  }
}
